/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: #FFFFFF;
  background: linear-gradient(180deg, #1a1a3e 0%, #2d2d5a 50%, #3d3d7a 100%);
  box-sizing: border-box;
}

/* 主题色变量 */
page {
  --primary-color: #6366f1;
  --primary-light: rgba(99, 102, 241, 0.2);
  --primary-dark: #4f46e5;
  --secondary-color: #8b5cf6;
  --success-color: #10b981;
  --warning-color: #f59e0b;
  --error-color: #ef4444;
  --text-primary: #FFFFFF;
  --text-secondary: rgba(255, 255, 255, 0.8);
  --text-hint: rgba(255, 255, 255, 0.6);
  --border-color: rgba(255, 255, 255, 0.15);
  --bg-color: linear-gradient(180deg, #1a1a3e 0%, #2d2d5a 50%, #3d3d7a 100%);
  --card-bg: rgba(255, 255, 255, 0.1);
  --shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  /* 深色主题变量 */
  --dark-bg: linear-gradient(180deg, #1a1a3e 0%, #2d2d5a 50%, #3d3d7a 100%);
  --dark-card-bg: rgba(255, 255, 255, 0.1);
  --dark-text: #FFFFFF;
  --dark-text-secondary: rgba(255, 255, 255, 0.7);
}

/* 通用容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg-color);
}

/* 卡片样式 */
.card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary-color);
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-secondary:active {
  opacity: 0.8;
}

/* 文字样式 */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-hint {
  color: var(--text-hint);
}

.text-center {
  text-align: center;
}

/* 弹性布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 间距 */
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-20 { margin-right: 20rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(180deg, #1a1a3e 0%, #2d2d5a 50%, #3d3d7a 100%);
  border-radius: 20rpx 20rpx 0 0;
}

/* TabBar 图标优化 */
.tabbar-icon {
  border-radius: 50%;
  padding: 8rpx;
  transition: all 0.3s ease;
}

.tabbar-icon.active {
  background: rgba(99, 102, 241, 0.2);
  transform: scale(1.1);
}

/* TabBar 整体样式优化 */
.tab-bar {
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  background: #2d2d5a;
  backdrop-filter: blur(10px);
  border-radius: 20rpx 20rpx 0 0;
}

/* TabBar 文字样式 */
.tab-bar-item {
  position: relative;
  border-radius: 16rpx;
  margin: 8rpx;
  transition: all 0.3s ease;
}

.tab-bar-item.active {
  background: rgba(99, 102, 241, 0.15);
}

/* 为 tabbar 添加圆润效果 */
.uni-tabbar {
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
}

.uni-tabbar__item {
  border-radius: 12rpx;
  margin: 6rpx;
  transition: all 0.3s ease;
}

.uni-tabbar__item.uni-tabbar__item--active {
  background: rgba(99, 102, 241, 0.1);
}

/* 加载动画 */
.loading-dots {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #8b5cf6;
  margin: 0 8rpx;
  animation: bounce 1.4s infinite ease-in-out both;
}

.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* 音频波浪纹动画 */
.audio-waves {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
}

.audio-wave {
  width: 4rpx;
  background: linear-gradient(to top, #6366f1, #8b5cf6);
  border-radius: 2rpx;
  animation: audio-wave 1.2s ease-in-out infinite;
}

.audio-wave:nth-child(1) { height: 12rpx; animation-delay: 0s; }
.audio-wave:nth-child(2) { height: 16rpx; animation-delay: 0.15s; }
.audio-wave:nth-child(3) { height: 24rpx; animation-delay: 0.3s; }
.audio-wave:nth-child(4) { height: 32rpx; animation-delay: 0.45s; }
.audio-wave:nth-child(5) { height: 28rpx; animation-delay: 0.6s; }
.audio-wave:nth-child(6) { height: 20rpx; animation-delay: 0.75s; }
.audio-wave:nth-child(7) { height: 16rpx; animation-delay: 0.9s; }

@keyframes audio-wave {
  0%, 100% { 
    transform: scaleY(0.3);
    opacity: 0.7;
  }
  50% { 
    transform: scaleY(1);
    opacity: 1;
  }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
}

.empty-state .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-state .empty-text {
  color: var(--text-hint);
  font-size: 28rpx;
}
