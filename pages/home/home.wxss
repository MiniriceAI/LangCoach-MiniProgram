.container {
  padding: 30rpx;
  padding-bottom: 180rpx;
  background: var(--bg-color);
  min-height: 100vh;
}

/* 顶部区域 */
.header-section {
  margin-bottom: 30rpx;
}

.greeting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.greeting-text {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.streak-badge {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.streak-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.streak-count {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.weekly-progress {
  background: var(--card-bg);
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: var(--shadow);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.progress-value {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 每日挑战卡片 */
.daily-challenge {
  background: linear-gradient(135deg, #2d2d5a 0%, #3d3d7a 100%);
  color: #FFFFFF;
  padding: 30rpx;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
}

.daily-challenge::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.challenge-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.challenge-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.badge-icon {
  margin-right: 8rpx;
}

.badge-text {
  font-size: 24rpx;
}

.difficulty-tag {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.challenge-content {
  margin-bottom: 24rpx;
}

.challenge-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.challenge-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.challenge-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-estimate {
  display: flex;
  align-items: center;
  opacity: 0.9;
}

.time-icon {
  margin-right: 8rpx;
}

.time-text {
  font-size: 24rpx;
}

.start-btn {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.start-btn .arrow {
  margin-left: 8rpx;
}

/* 快速练习 */
.quick-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.quick-buttons {
  display: flex;
  gap: 20rpx;
}

.quick-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
  box-shadow: var(--shadow);
}

.quick-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.quick-name {
  font-size: 28rpx;
  font-weight: 500;
}

/* 话题分类 */
.topics-section {
  margin-bottom: 30rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-card {
  padding: 0;
  overflow: hidden;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.category-info {
  display: flex;
  align-items: center;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.category-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.category-arrow {
  color: var(--text-hint);
  font-size: 24rpx;
  transition: transform 0.3s ease;
}

.category-arrow.rotated {
  transform: rotate(180deg);
}

/* 场景列表 */
.scenario-list {
  border-top: 1rpx solid var(--border-color);
  padding: 0 24rpx;
}

.scenario-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.scenario-item:last-child {
  border-bottom: none;
}

.scenario-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.scenario-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.difficulty-badge {
  color: white;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.scenario-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.scenario-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.time-info {
  font-size: 22rpx;
  color: var(--text-hint);
}

.scenario-item:active {
  background: var(--bg-color);
}

/* 自定义场景卡片 */
.custom-scenario-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.custom-card-content {
  display: flex;
  align-items: center;
}

.custom-card-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.custom-card-info {
  display: flex;
  flex-direction: column;
}

.custom-card-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.custom-card-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.custom-card-btn {
  background: rgba(255, 255, 255, 0.25);
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.custom-card-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

/* 弹窗通用样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  background: linear-gradient(145deg, #2d2d5a 0%, #3d3d7a 100%);
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
}

/* 自定义场景输入弹窗 */
.custom-input-modal {
  padding: 0 0 env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
}

.modal-cancel {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.modal-confirm {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.modal-confirm.disabled {
  color: var(--text-hint);
}

.modal-random {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.modal-random:active {
  opacity: 0.7;
}

.modal-body {
  padding: 30rpx;
}

.custom-input-textarea {
  width: 100%;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.input-counter {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

.confirm-scenario-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
}

.confirm-scenario-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.confirm-scenario-btn.disabled {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.confirm-scenario-btn.disabled:active {
  opacity: 1;
  transform: none;
}

.random-scenario-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
}

.random-scenario-btn:active {
  opacity: 0.9;
}

.random-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

/* 场景预览弹窗 */
.scenario-preview-modal {
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.preview-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E8E8E8;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.preview-content {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.preview-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.preview-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.preview-title-section {
  flex: 1;
}

.preview-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.preview-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.preview-task-badge {
  display: inline-block;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.task-label {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.preview-task-desc {
  background: rgba(99, 102, 241, 0.2);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.3);
}

.preview-task-desc text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

.preview-roles {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.role-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.role-label {
  display: block;
  font-size: 22rpx;
  color: #6366f1;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(99, 102, 241, 0.2);
  border-radius: 8rpx;
  display: inline-block;
}

.role-value {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-top: 12rpx;
}

.role-value-en {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.preview-section {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6366f1;
  margin-bottom: 12rpx;
}

.section-content {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.section-content-en {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  line-height: 1.5;
}

.preview-settings {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.setting-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.setting-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 12rpx;
}

.setting-value {
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.setting-value.easy {
  color: #52C41A;
}

.setting-value.medium {
  color: #FAAD14;
}

.setting-value.hard {
  color: #FF4D4F;
}

.preview-start-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 28rpx;
  border-radius: 50rpx;
  text-align: center;
}

.preview-start-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.preview-start-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
