<view class="container">
  <!-- 顶部欢迎区域 -->
  <view class="header-section">
    <view class="greeting">
      <text class="greeting-text">Hi，准备好练习了吗？</text>
      <view class="streak-badge" wx:if="{{stats.streak > 0}}">
        <text class="streak-icon">🔥</text>
        <text class="streak-count">{{stats.streak}}天</text>
      </view>
    </view>
    <view class="weekly-progress">
      <view class="progress-info">
        <text class="progress-label">本周目标</text>
        <text class="progress-value">{{stats.todayMinutes}}/{{stats.weeklyGoal}}分钟</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{stats.weeklyProgress}}%"></view>
      </view>
    </view>
  </view>

  <!-- 自定义场景卡片 -->
  <view class="custom-scenario-card card" bindtap="showCustomScenarioModal">
    <view class="custom-card-content">
      <view class="custom-card-icon">✨</view>
      <view class="custom-card-info">
        <text class="custom-card-title">自定义场景</text>
        <text class="custom-card-desc">自己决定聊什么</text>
      </view>
    </view>
    <view class="custom-card-btn">
      <text>开始畅聊</text>
    </view>
  </view>

  <!-- 每日挑战卡片 -->
  <view class="daily-challenge card" bindtap="startDailyChallenge">
    <view class="challenge-header">
      <view class="challenge-badge">
        <text class="badge-icon">⭐</text>
        <text class="badge-text">每日挑战</text>
      </view>
      <view class="difficulty-tag" style="background: {{dailyChallenge.difficulty === 'A1' || dailyChallenge.difficulty === 'A2' ? '#52C41A' : dailyChallenge.difficulty === 'B1' || dailyChallenge.difficulty === 'B2' ? '#FAAD14' : '#FF4D4F'}}">
        {{dailyChallenge.difficulty}}
      </view>
    </view>
    <view class="challenge-content">
      <text class="challenge-title">{{dailyChallenge.title}}</text>
      <text class="challenge-desc">{{dailyChallenge.description}}</text>
    </view>
    <view class="challenge-footer">
      <view class="time-estimate">
        <text class="time-icon">⏱️</text>
        <text class="time-text">约{{dailyChallenge.estimatedTime}}分钟</text>
      </view>
      <view class="start-btn">
        <text>开始挑战</text>
        <text class="arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 快速练习 -->
  <view class="quick-section">
    <view class="section-title">快速开始</view>
    <view class="quick-buttons">
      <view
        class="quick-btn"
        wx:for="{{quickScenarios}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="startQuickPractice"
        style="background: {{item.color}}"
      >
        <text class="quick-icon">{{item.icon}}</text>
        <text class="quick-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 话题分类 -->
  <view class="topics-section">
    <view class="section-title">选择话题</view>
    <view class="category-list">
      <view
        class="category-card card {{expandedCategory === item.id ? 'expanded' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
      >
        <view
          class="category-header"
          data-id="{{item.id}}"
          bindtap="toggleCategory"
        >
          <view class="category-info">
            <view class="category-icon" style="background: {{item.color}}20">
              <text>{{item.icon}}</text>
            </view>
            <text class="category-name">{{item.name}}</text>
          </view>
          <view class="category-arrow {{expandedCategory === item.id ? 'rotated' : ''}}">
            <text>▼</text>
          </view>
        </view>

        <view class="scenario-list" wx:if="{{expandedCategory === item.id}}">
          <view
            class="scenario-item"
            wx:for="{{item.scenarios}}"
            wx:for-item="scenario"
            wx:key="id"
            data-category="{{item.id}}"
            data-scenario="{{scenario.id}}"
            bindtap="selectScenario"
          >
            <view class="scenario-header">
              <text class="scenario-name">{{scenario.name}}</text>
              <view class="difficulty-badge" style="background: {{scenario.difficulty === 'A1' || scenario.difficulty === 'A2' ? '#52C41A' : scenario.difficulty === 'B1' || scenario.difficulty === 'B2' ? '#FAAD14' : '#FF4D4F'}}">
                {{scenario.difficulty}}
              </view>
            </view>
            <text class="scenario-desc">{{scenario.description}}</text>
            <view class="scenario-meta">
              <text class="time-info">⏱️ 约{{scenario.estimatedTime}}分钟</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 自定义场景输入弹窗 -->
  <view class="modal-overlay" wx:if="{{showCustomInputModal}}" bindtap="hideCustomInputModal">
    <view class="modal-content custom-input-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-cancel" bindtap="hideCustomInputModal">取消</text>
        <text class="modal-title">自定义场景</text>
        <text class="modal-confirm {{customScenarioInput ? '' : 'disabled'}}" bindtap="submitCustomScenario">确定</text>
      </view>
      <view class="modal-body">
        <textarea
          class="custom-input-textarea"
          placeholder="描述你想练习的场景，例如：小学三年级学生，去超市买文具"
          value="{{customScenarioInput}}"
          bindinput="onCustomInputChange"
          maxlength="200"
          auto-focus
        />
        <view class="input-counter">{{customScenarioInput.length || 0}}/200</view>
        <view class="random-scenario-btn" bindtap="generateRandomScenario">
          <text class="random-icon">🎲</text>
          <text>随机场景</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 场景预览弹窗 -->
  <view class="modal-overlay" wx:if="{{showScenarioPreviewModal}}" bindtap="hideScenarioPreviewModal">
    <view class="modal-content scenario-preview-modal" catchtap="">
      <!-- 加载状态 -->
      <view class="preview-loading" wx:if="{{isExtractingScenario}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">AI正在分析场景...</text>
      </view>

      <!-- 预览内容 -->
      <view class="preview-content" wx:else>
        <view class="preview-header">
          <view class="preview-icon">✏️</view>
          <view class="preview-title-section">
            <text class="preview-title">{{customScenarioInput}}</text>
            <text class="preview-subtitle">{{scenarioPreview.scenario_summary}}</text>
          </view>
        </view>

        <view class="preview-task-badge">
          <text class="task-label">Task</text>
        </view>
        <view class="preview-task-desc">
          <text>与{{scenarioPreview.ai_role_cn}}进行角色扮演，请尽量高效完成以下对话目标和挑战，系统会自动帮你判断任务完成情况～</text>
        </view>

        <view class="preview-roles">
          <view class="role-item">
            <text class="role-label">AI机器人 | AI robot</text>
            <text class="role-value">{{scenarioPreview.ai_role_cn}}</text>
            <text class="role-value-en">{{scenarioPreview.ai_role}}</text>
          </view>
          <view class="role-item">
            <text class="role-label">我的角色 | My role</text>
            <text class="role-value">{{scenarioPreview.user_role_cn}}</text>
            <text class="role-value-en">{{scenarioPreview.user_role}}</text>
          </view>
        </view>

        <view class="preview-section">
          <text class="section-title">目标</text>
          <text class="section-content">{{scenarioPreview.goal_cn}}</text>
          <text class="section-content-en">{{scenarioPreview.goal}}</text>
        </view>

        <view class="preview-section">
          <text class="section-title">挑战</text>
          <text class="section-content">{{scenarioPreview.challenge_cn}}</text>
          <text class="section-content-en">{{scenarioPreview.challenge}}</text>
        </view>

        <view class="preview-settings">
          <view class="setting-item">
            <text class="setting-label">难度</text>
            <text class="setting-value {{scenarioPreview.difficulty_level}}">{{scenarioPreview.difficulty_level === 'easy' ? '简单' : scenarioPreview.difficulty_level === 'medium' ? '中等' : '困难'}}</text>
          </view>
          <view class="setting-item">
            <text class="setting-label">语速</text>
            <text class="setting-value">{{scenarioPreview.speaking_speed === 'slow' ? '慢速' : scenarioPreview.speaking_speed === 'medium' ? '正常' : '快速'}}</text>
          </view>
          <view class="setting-item">
            <text class="setting-label">词汇</text>
            <text class="setting-value">{{scenarioPreview.vocabulary === 'simple' ? '简单' : scenarioPreview.vocabulary === 'medium' ? '中等' : '高级'}}</text>
          </view>
        </view>

        <view class="preview-start-btn" bindtap="startCustomScenarioChat">
          <text>开始对话</text>
        </view>
      </view>
    </view>
  </view>
</view>
