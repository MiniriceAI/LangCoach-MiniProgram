.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 180rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  padding: 60rpx 30rpx 40rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

.user-card::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 30rpx;
}

.user-detail {
  flex: 1;
}

.nickname {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.level-icon {
  margin-right: 8rpx;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 统计数据 */
.stats-row {
  display: flex;
  justify-content: space-around;
  position: relative;
  z-index: 1;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 成就卡片 */
.achievement-section {
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.view-all {
  font-size: 26rpx;
  color: var(--primary-color);
}

.achievement-list {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
  padding-bottom: 10rpx;
}

.achievement-item {
  flex-shrink: 0;
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.achievement-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 12rpx;
  border-radius: 50%;
  background: var(--bg-color);
}

.achievement-item.locked .achievement-icon {
  filter: grayscale(100%);
  opacity: 0.5;
}

.achievement-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 设置列表 */
.settings-section {
  padding: 0 30rpx 30rpx;
}

.settings-group {
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}

.settings-list {
  border-radius: 24rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 24rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: var(--bg-color);
}

.setting-left {
  display: flex;
  align-items: center;
}

.setting-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.setting-name {
  font-size: 30rpx;
  color: var(--text-primary);
}

.setting-right {
  display: flex;
  align-items: center;
}

.setting-value {
  font-size: 28rpx;
  color: var(--text-hint);
  margin-right: 12rpx;
}

.setting-arrow {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 开关样式 */
.switch {
  transform: scale(0.8);
}

/* 难度选择器 */
.level-selector {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.level-selector.show {
  transform: translateY(0);
}

.selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.selector-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.selector-close {
  font-size: 40rpx;
  color: var(--text-hint);
  padding: 10rpx;
}

.level-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.level-option {
  width: calc(50% - 10rpx);
  padding: 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  text-align: center;
}

.level-option.selected {
  border-color: var(--primary-color);
  background: var(--primary-light);
}

.level-code {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.level-option.selected .level-code {
  color: var(--primary-color);
}

.level-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 遮罩层 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 语音选择器 */
.voice-selector {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
  overflow-y: auto;
}

.voice-selector.show {
  transform: translateY(0);
}

.voice-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.voice-option {
  padding: 32rpx 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  background: var(--card-bg);
  transition: all 0.2s ease;
}

.voice-option.selected {
  border-color: var(--primary-color);
  background: var(--primary-light);
}

.voice-info {
  display: flex;
  flex-direction: column;
}

.voice-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.voice-option.selected .voice-name {
  color: var(--primary-color);
}

.voice-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}
