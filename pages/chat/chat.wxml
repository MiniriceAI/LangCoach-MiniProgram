<view class="chat-container">
  <!-- 顶部场景信息 -->
  <view class="chat-header">
    <view class="header-left" bindtap="onExitTap">
      <text class="exit-icon">✕</text>
    </view>
    <view class="scenario-info">
      <text class="scenario-title">{{scenarioTitle}}</text>
    </view>
    <view class="header-right">
      <view class="settings-btn" bindtap="showSessionSettings">
        <text class="settings-icon">⚙️</text>
      </view>
      <view class="turn-counter" wx:if="{{!isCustomScenario}}">{{currentTurn}}/{{maxTurns}}</view>
      <view class="turn-counter" wx:else>自由对话</view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="message-list"
    scroll-y
    scroll-into-view="{{scrollToMessage}}"
    scroll-with-animation
  >
    <!-- 空状态 -->
    <view class="empty-chat" wx:if="{{messages.length === 0 && !isLoading}}">
      <text class="empty-icon">💬</text>
      <text class="empty-title">准备开始对话</text>
      <text class="empty-desc">点击下方按钮开始语音对话，或切换到文字输入模式</text>
    </view>

    <!-- 消息列表 -->
    <view
      class="message-item {{item.role}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="{{item.id}}"
    >
      <image
        class="avatar"
        src="{{item.role === 'assistant' ? '/images/ai-avatar.png' : '/images/user-avatar.png'}}"
        mode="aspectFill"
      />
      <view class="message-content">
        <view class="bubble {{item.role === 'user' ? 'user-bubble' : 'assistant-bubble'}}">
          <chat-bubble
            id="bubble-{{index}}"
            content="{{item.hideText ? '' : item.content}}"
            role="{{item.role}}"
            audio-url="{{item.audioUrl}}"
            duration="{{item.duration}}"
            transcribing="{{item.transcribing}}"
            error="{{item.error}}"
            playing="{{playingMessageId === item.id}}"
            hide-text="{{item.hideText}}"
            message-id="{{item.id}}"
            bind:wordtap="onWordTap"
            bind:audiotap="onAudioTap"
          />
        </view>

        <!-- AI消息的操作按钮 -->
        <view class="message-actions" wx:if="{{item.role === 'assistant' && item.content && !item.transcribing}}">
          <!-- 重新播放按钮 -->
          <view
            class="action-btn replay-btn"
            wx:if="{{item.audioUrl}}"
            data-id="{{item.id}}"
            data-audio-url="{{item.audioUrl}}"
            bindtap="replayAudio"
          >
            <text class="action-icon">🔊</text>
          </view>
          <!-- 反馈按钮 -->
          <text
            class="feedback-btn {{item.userFeedback === 'like' ? 'active' : ''}}"
            data-id="{{item.id}}"
            data-type="like"
            bindtap="onFeedback"
          >👍</text>
          <text
            class="feedback-btn {{item.userFeedback === 'dislike' ? 'active' : ''}}"
            data-id="{{item.id}}"
            data-type="dislike"
            bindtap="onFeedback"
          >👎</text>
        </view>

        <!-- 对话提示 (提示模式下显示) -->
        <view class="chat-tips-card" wx:if="{{item.role === 'assistant' && item.showTips && item.chatTips && learningMode === 'prompt'}}">
          <view class="tips-header">
            <text class="tips-label">对话提示</text>
            <text class="tips-icon">💡</text>
          </view>
          <view class="tips-content">
            <text class="tips-english">{{item.chatTips.english}}</text>
            <text class="tips-chinese">{{item.chatTips.chinese}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="message-item assistant" wx:if="{{isLoading}}">
      <image class="avatar" src="/images/ai-avatar.png" mode="aspectFill" />
      <view class="message-content">
        <view class="loading-message">
          <view class="loading-dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 学习模式切换 -->
  <view class="mode-selector">
    <view
      class="mode-btn {{learningMode === 'prompt' ? 'active' : ''}}"
      data-mode="prompt"
      bindtap="switchLearningMode"
    >
      <text class="mode-icon">📝</text>
      <text class="mode-text">提示模式</text>
    </view>
    <view
      class="mode-btn {{learningMode === 'listening' ? 'active' : ''}}"
      data-mode="listening"
      bindtap="switchLearningMode"
    >
      <text class="mode-icon">🎧</text>
      <text class="mode-text">听力模式</text>
    </view>
  </view>

  <!-- 底部输入区域 -->
  <view class="input-area" style="padding-bottom: {{keyboardHeight > 0 ? keyboardHeight + 'px' : 'calc(20rpx + env(safe-area-inset-bottom))'}}">
    <view class="input-wrapper">
      <!-- 切换按钮 -->
      <view class="mode-switch" bindtap="toggleInputMode">
        <text>{{inputMode === 'voice' ? '⌨️' : '🎤'}}</text>
      </view>

      <!-- 语音输入 -->
      <view class="voice-input-wrapper" wx:if="{{inputMode === 'voice'}}">
        <view
          class="voice-btn {{isRecording ? 'recording' : ''}} {{isCancelArea ? 'cancel-area' : ''}} {{!sessionReady ? 'disabled' : ''}}"
          bindtouchstart="{{sessionReady ? 'onTouchStart' : ''}}"
          bindtouchmove="{{sessionReady ? 'onTouchMove' : ''}}"
          bindtouchend="{{sessionReady ? 'onTouchEnd' : ''}}"
          bindtouchcancel="{{sessionReady ? 'onTouchEnd' : ''}}"
          bindtap="{{!sessionReady ? 'onSessionNotReady' : ''}}"
        >
          <text>{{!sessionReady ? '连接中...' : (isRecording ? (isCancelArea ? '松开取消' : '松开发送') : '按住说话')}}</text>
        </view>
      </view>

      <!-- 文字输入 -->
      <view class="text-input-wrapper" wx:else>
        <input
          class="text-input"
          placeholder="{{sessionReady ? '输入消息...' : '连接中...'}}"
          value="{{inputText}}"
          bindinput="onInputChange"
          bindconfirm="sendTextMessage"
          confirm-type="send"
          adjust-position="{{false}}"
          bindkeyboardheightchange="onKeyboardHeightChange"
          disabled="{{!sessionReady}}"
        />
      </view>

      <!-- 发送按钮 -->
      <view
        class="send-btn {{inputText && sessionReady ? '' : 'disabled'}}"
        wx:if="{{inputMode === 'text'}}"
        bindtap="{{sessionReady ? 'sendTextMessage' : 'onSessionNotReady'}}"
      >
        <text style="color: #fff; font-size: 36rpx;">➤</text>
      </view>
    </view>
  </view>

  <!-- 录音状态遮罩 -->
  <view class="recording-overlay {{isCancelArea ? 'cancel-mode' : ''}}" wx:if="{{isRecording}}">
    <view class="recording-indicator {{isCancelArea ? 'cancel-state' : ''}}">
      <view class="recording-icon">
        <text class="mic-icon">{{isCancelArea ? '❌' : '🎤'}}</text>
      </view>
      <text class="recording-time">{{recordingDuration}}"</text>
      <text class="recording-tip">{{isCancelArea ? '松开取消录音' : '松开发送，上滑取消'}}</text>
    </view>
    <view class="cancel-area {{isCancelArea ? 'active' : ''}}">
      <text class="cancel-text">↑ 上滑取消</text>
    </view>
  </view>

  <!-- 评分弹窗 -->
  <rating-modal
    wx:if="{{showRatingModal}}"
    show="{{showRatingModal}}"
    report="{{sessionReport}}"
    bind:submit="onRatingSubmit"
    bind:close="closeRatingModal"
    bind:restart="restartSession"
  />

  <!-- 音频权限提示 -->
  <view class="audio-tip-overlay" wx:if="{{showAudioTip}}">
    <view class="audio-tip-modal">
      <view class="tip-icon">🔊</view>
      <text class="tip-title">开启音频播放</text>
      <text class="tip-desc">点击任意音频按钮开启自动播放功能</text>
      <view class="tip-actions">
        <view class="tip-btn cancel" bindtap="hideAudioTip">知道了</view>
      </view>
    </view>
  </view>

  <!-- 开场白音频播放提示 - 首次进入时显示 -->
  <view class="greeting-audio-tip" wx:if="{{showGreetingPlayTip && pendingGreetingAudio}}" bindtap="onGreetingPlayTap">
    <view class="greeting-tip-content">
      <view class="greeting-tip-icon">🔊</view>
      <text class="greeting-tip-text">点击播放语音</text>
    </view>
  </view>

  <!-- 退出确认弹窗 -->
  <view class="exit-modal-overlay" wx:if="{{showExitModal}}" bindtap="hideExitModal">
    <view class="exit-modal-content" catchtap="">
      <view class="exit-modal-icon">💬</view>
      <view class="exit-modal-title">坚持就是胜利!</view>
      <view class="exit-modal-stats">
        <text>已对话 {{currentTurn}} 轮</text>
        <text wx:if="{{!isCustomScenario}}"> 争取对话 10 轮以上有更好的练习效果哟</text>
        <text wx:else> 继续练习可以获得更好的效果哟</text>
      </view>
      <view class="exit-modal-actions">
        <view class="exit-btn continue" bindtap="hideExitModal">
          <text class="btn-icon">💪</text>
          <text>再练一下</text>
        </view>
        <view class="exit-btn quit" bindtap="confirmExit">
          <text>直接退出</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 会话设置弹窗 -->
  <view class="session-settings-overlay" wx:if="{{showSessionSettings}}" bindtap="hideSessionSettings">
    <view class="session-settings-modal" catchtap="">
      <view class="settings-header">
        <text class="settings-title">对话设置</text>
        <text class="settings-close" bindtap="hideSessionSettings">×</text>
      </view>

      <view class="settings-tip">
        <text>相关设置修改后，将在下一次进入对话时生效</text>
      </view>

      <!-- 发音设置 -->
      <view class="setting-section">
        <view class="section-title">发音设置</view>
        <scroll-view class="voice-scroll" scroll-y scroll-with-animation>
          <view class="voice-options">
            <view
              class="voice-option {{sessionSettings.speaker === item.code ? 'selected' : ''}}"
              wx:for="{{voiceOptions}}"
              wx:key="code"
              data-voice="{{item.code}}"
              bindtap="selectSessionVoice"
            >
              <text class="voice-name">{{item.name}}</text>
              <text class="voice-desc">{{item.desc}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 语速设置 -->
      <view class="setting-section">
        <view class="section-title">语速设置</view>
        <view class="speed-options">
          <view
            class="speed-option {{sessionSettings.speakingSpeed === 'slow' ? 'selected' : ''}}"
            data-speed="slow"
            bindtap="selectSpeakingSpeed"
          >
            <text>较慢</text>
          </view>
          <view
            class="speed-option {{sessionSettings.speakingSpeed === 'medium' ? 'selected' : ''}}"
            data-speed="medium"
            bindtap="selectSpeakingSpeed"
          >
            <text>标准</text>
          </view>
          <view
            class="speed-option {{sessionSettings.speakingSpeed === 'fast' ? 'selected' : ''}}"
            data-speed="fast"
            bindtap="selectSpeakingSpeed"
          >
            <text>较快</text>
          </view>
        </view>

        <!-- 精确语速滑块 -->
        <view class="speed-slider-container">
          <view class="slider-label">
            <text>精确调节</text>
            <text class="slider-value">{{sessionSettings.speakingRatePercent}}%</text>
          </view>
          <slider
            class="speed-slider"
            min="-50"
            max="100"
            step="10"
            value="{{sessionSettings.speakingRatePercent}}"
            activeColor="#5B8FF9"
            backgroundColor="#E8E8E8"
            block-size="20"
            bindchange="onSpeakingRateChange"
            bindchanging="onSpeakingRateChanging"
          />
          <view class="slider-marks">
            <text>1s</text>
            <text>6s</text>
          </view>
        </view>
      </view>

      <!-- 保存按钮 -->
      <view class="settings-actions">
        <view class="settings-btn save" bindtap="saveSessionSettings">
          <text>保存</text>
        </view>
      </view>
    </view>
  </view>
</view>
