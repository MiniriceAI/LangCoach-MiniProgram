<view class="chat-container">
  <!-- 顶部场景信息 -->
  <view class="chat-header">
    <view class="scenario-info">
      <text class="scenario-title">{{scenarioTitle}}</text>
    </view>
    <view class="turn-counter">{{currentTurn}}/{{maxTurns}}</view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="message-list"
    scroll-y
    scroll-into-view="{{scrollToMessage}}"
    scroll-with-animation
  >
    <!-- 空状态 -->
    <view class="empty-chat" wx:if="{{messages.length === 0 && !isLoading}}">
      <text class="empty-icon">💬</text>
      <text class="empty-title">准备开始对话</text>
      <text class="empty-desc">点击下方按钮开始语音对话，或切换到文字输入模式</text>
    </view>

    <!-- 消息列表 -->
    <view
      class="message-item {{item.role}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="{{item.id}}"
    >
      <image
        class="avatar"
        src="{{item.role === 'assistant' ? '/images/ai-avatar.png' : '/images/user-avatar.png'}}"
        mode="aspectFill"
      />
      <view class="message-content">
        <view class="bubble {{item.role === 'user' ? 'user-bubble' : 'assistant-bubble'}}">
          <chat-bubble
            id="bubble-{{index}}"
            content="{{item.hideText ? '' : item.content}}"
            role="{{item.role}}"
            audio-url="{{item.audioUrl}}"
            duration="{{item.duration}}"
            transcribing="{{item.transcribing}}"
            error="{{item.error}}"
            playing="{{playingMessageId === item.id}}"
            hide-text="{{item.hideText}}"
            bind:wordtap="onWordTap"
            bind:audiotap="onAudioTap"
          />
        </view>

        <!-- AI消息的操作按钮 -->
        <view class="message-actions" wx:if="{{item.role === 'assistant' && item.content && !item.transcribing}}">
          <!-- 重新播放按钮 -->
          <view
            class="action-btn replay-btn"
            wx:if="{{item.audioUrl}}"
            data-id="{{item.id}}"
            data-audio-url="{{item.audioUrl}}"
            bindtap="replayAudio"
          >
            <text class="action-icon">🔊</text>
          </view>
          <!-- 反馈按钮 -->
          <text
            class="feedback-btn {{item.userFeedback === 'like' ? 'active' : ''}}"
            data-id="{{item.id}}"
            data-type="like"
            bindtap="onFeedback"
          >👍</text>
          <text
            class="feedback-btn {{item.userFeedback === 'dislike' ? 'active' : ''}}"
            data-id="{{item.id}}"
            data-type="dislike"
            bindtap="onFeedback"
          >👎</text>
        </view>

        <!-- 对话提示 (提示模式下显示) -->
        <view class="chat-tips-card" wx:if="{{item.role === 'assistant' && item.showTips && item.chatTips && learningMode === 'prompt'}}">
          <view class="tips-header">
            <text class="tips-label">对话提示</text>
            <text class="tips-icon">💡</text>
          </view>
          <view class="tips-content">
            <text class="tips-english">{{item.chatTips.english}}</text>
            <text class="tips-chinese">{{item.chatTips.chinese}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="message-item assistant" wx:if="{{isLoading}}">
      <image class="avatar" src="/images/ai-avatar.png" mode="aspectFill" />
      <view class="message-content">
        <view class="loading-message">
          <view class="loading-dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 学习模式切换 -->
  <view class="mode-selector">
    <view
      class="mode-btn {{learningMode === 'prompt' ? 'active' : ''}}"
      data-mode="prompt"
      bindtap="switchLearningMode"
    >
      <text class="mode-icon">📝</text>
      <text class="mode-text">提示模式</text>
    </view>
    <view
      class="mode-btn {{learningMode === 'listening' ? 'active' : ''}}"
      data-mode="listening"
      bindtap="switchLearningMode"
    >
      <text class="mode-icon">🎧</text>
      <text class="mode-text">听力模式</text>
    </view>
  </view>

  <!-- 底部输入区域 -->
  <view class="input-area" style="padding-bottom: {{keyboardHeight > 0 ? keyboardHeight + 'px' : 'calc(20rpx + env(safe-area-inset-bottom))'}}">
    <view class="input-wrapper">
      <!-- 切换按钮 -->
      <view class="mode-switch" bindtap="toggleInputMode">
        <text>{{inputMode === 'voice' ? '⌨️' : '🎤'}}</text>
      </view>

      <!-- 语音输入 -->
      <view class="voice-input-wrapper" wx:if="{{inputMode === 'voice'}}">
        <view
          class="voice-btn {{isRecording ? 'recording' : ''}} {{isCancelArea ? 'cancel-area' : ''}}"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchEnd"
        >
          <text>{{isRecording ? (isCancelArea ? '松开取消' : '松开发送') : '按住说话'}}</text>
        </view>
      </view>

      <!-- 文字输入 -->
      <view class="text-input-wrapper" wx:else>
        <input
          class="text-input"
          placeholder="输入消息..."
          value="{{inputText}}"
          bindinput="onInputChange"
          bindconfirm="sendTextMessage"
          confirm-type="send"
          adjust-position="{{false}}"
          bindkeyboardheightchange="onKeyboardHeightChange"
        />
      </view>

      <!-- 发送按钮 -->
      <view
        class="send-btn {{inputText ? '' : 'disabled'}}"
        wx:if="{{inputMode === 'text'}}"
        bindtap="sendTextMessage"
      >
        <text style="color: #fff; font-size: 36rpx;">➤</text>
      </view>
    </view>
  </view>

  <!-- 录音状态遮罩 -->
  <view class="recording-overlay {{isCancelArea ? 'cancel-mode' : ''}}" wx:if="{{isRecording}}">
    <view class="recording-indicator {{isCancelArea ? 'cancel-state' : ''}}">
      <view class="recording-icon">
        <text class="mic-icon">{{isCancelArea ? '❌' : '🎤'}}</text>
      </view>
      <text class="recording-time">{{recordingDuration}}"</text>
      <text class="recording-tip">{{isCancelArea ? '松开取消录音' : '松开发送，上滑取消'}}</text>
    </view>
    <view class="cancel-area {{isCancelArea ? 'active' : ''}}">
      <text class="cancel-text">↑ 上滑取消</text>
    </view>
  </view>

  <!-- 评分弹窗 -->
  <rating-modal
    wx:if="{{showRatingModal}}"
    show="{{showRatingModal}}"
    report="{{sessionReport}}"
    bind:submit="onRatingSubmit"
    bind:close="closeRatingModal"
    bind:restart="restartSession"
  />
</view>
