.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #1a1a3e 0%, #2d2d5a 50%, #3d3d7a 100%);
}

/* 顶部场景信息 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.header-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exit-icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-left:active {
  opacity: 0.7;
}

.scenario-info {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: center;
}

.scenario-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.turn-counter {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 消息列表区域 */
.message-list {
  flex: 1;
  padding: 20rpx 30rpx;
  overflow-y: auto;
}

/* 消息气泡 */
.message-item {
  display: flex;
  margin-bottom: 30rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-content {
  max-width: 70%;
  margin: 0 20rpx;
}

.bubble {
  padding: 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-word;
}

.message-item.assistant .bubble {
  background: rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  border-top-left-radius: 8rpx;
  backdrop-filter: blur(10px);
}

.message-item.user .bubble {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #FFFFFF;
  border-top-right-radius: 8rpx;
}

/* 语音消息 */
.voice-bubble {
  display: flex;
  align-items: center;
  min-width: 160rpx;
}

.voice-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.voice-duration {
  font-size: 26rpx;
}

.voice-waves {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.voice-waves .wave {
  width: 6rpx;
  height: 24rpx;
  background: currentColor;
  margin: 0 4rpx;
  border-radius: 3rpx;
  animation: wave 1s ease-in-out infinite;
}

.voice-waves .wave:nth-child(2) { animation-delay: 0.1s; height: 32rpx; }
.voice-waves .wave:nth-child(3) { animation-delay: 0.2s; height: 40rpx; }
.voice-waves .wave:nth-child(4) { animation-delay: 0.3s; height: 32rpx; }

@keyframes wave {
  0%, 100% { transform: scaleY(0.5); }
  50% { transform: scaleY(1); }
}

/* 转写文本 */
.transcription {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.message-item.user .transcription {
  color: rgba(255, 255, 255, 0.8);
  text-align: right;
}

/* 消息时间 */
.message-time {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.message-item.user .message-time {
  text-align: right;
}

/* 反馈按钮 */
.feedback-actions {
  display: flex;
  margin-top: 12rpx;
}

.feedback-btn {
  padding: 8rpx 16rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  background: var(--bg-color);
  border-radius: 16rpx;
}

.feedback-btn.active {
  color: var(--primary-color);
  background: var(--primary-light);
}

/* 语法反馈 */
.grammar-feedback {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #FFF7E6;
  border-radius: 12rpx;
  border-left: 4rpx solid #FAAD14;
}

.feedback-title {
  font-size: 24rpx;
  color: #D48806;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.feedback-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 加载状态 */
.loading-message {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  border-top-left-radius: 8rpx;
  backdrop-filter: blur(10px);
}

/* 底部输入区域 */
.input-area {
  background: rgba(255, 255, 255, 0.1);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.input-wrapper {
  display: flex;
  align-items: center;
}

.mode-switch {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.text-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  padding: 0 30rpx;
  margin: 0 16rpx;
}

.text-input {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  color: #FFFFFF;
}

.text-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 50%;
  flex-shrink: 0;
}

.send-btn.disabled {
  background: rgba(255, 255, 255, 0.2);
}

.send-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 语音输入按钮 */
.voice-input-wrapper {
  flex: 1;
  margin: 0 16rpx;
}

.voice-btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 40rpx;
  font-size: 30rpx;
  color: #FFFFFF;
}

.voice-btn.recording {
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #FFFFFF;
}

.voice-btn.cancel-area {
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  color: #FFFFFF;
}

.voice-btn.disabled {
  background: linear-gradient(135deg, #6b7280 0%, #9ca3af 100%);
  color: rgba(255, 255, 255, 0.6);
  opacity: 0.7;
}

/* 录音状态提示 */
.recording-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.recording-overlay.cancel-mode {
  background: rgba(251, 191, 36, 0.3);
}

.recording-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
  background: rgba(0, 0, 0, 0.8);
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.recording-indicator.cancel-state {
  background: rgba(245, 158, 11, 0.9);
  transform: scale(1.05);
}

.recording-icon {
  width: 120rpx;
  height: 120rpx;
  background: #FF4D4F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.1); opacity: 0.8; }
}

.mic-icon {
  font-size: 60rpx;
}

.recording-time {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.recording-tip {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.cancel-area {
  margin-top: 60rpx;
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.cancel-area.active {
  background: rgba(245, 158, 11, 0.8);
  transform: scale(1.1);
}

.cancel-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 空状态 */
.empty-chat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

/* 学习模式切换 */
.mode-selector {
  display: flex;
  justify-content: center;
  padding: 16rpx 30rpx;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.05);
}

.mode-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s;
}

.mode-btn.active {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-color: transparent;
}

.mode-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.mode-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 消息操作按钮 */
.message-actions {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.action-icon {
  font-size: 28rpx;
}

.replay-btn:active {
  background: rgba(255, 255, 255, 0.2);
}

/* 反馈按钮 */
.feedback-btn {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
}

.feedback-btn.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
}

/* 对话提示卡片 */
.chat-tips-card {
  margin-top: 16rpx;
  padding: 20rpx;
  background: rgba(99, 102, 241, 0.2);
  border-radius: 16rpx;
  border-left: 4rpx solid #8b5cf6;
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tips-label {
  font-size: 24rpx;
  color: #a5b4fc;
  font-weight: 500;
}

.tips-icon {
  margin-left: 8rpx;
  font-size: 24rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tips-english {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.5;
}

.tips-chinese {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

/* 音频权限提示 */
.audio-tip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.audio-tip-modal {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 40rpx;
  margin: 40rpx;
  text-align: center;
  max-width: 600rpx;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.tip-title {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.tip-desc {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.tip-actions {
  display: flex;
  justify-content: center;
}

.tip-btn {
  padding: 20rpx 60rpx;
  border-radius: 30rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.tip-btn.cancel {
  background: #F3F4F6;
  color: #6B7280;
}

/* 听力模式下的语音框样式 */
.listening-mode-audio {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  min-height: 100rpx;
}

.audio-wave-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.audio-status-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 开场白音频播放提示 */
.greeting-audio-tip {
  position: fixed;
  bottom: 300rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  animation: pulse 2s infinite;
}

.greeting-tip-content {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  padding: 24rpx 40rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(99, 102, 241, 0.4);
}

.greeting-tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.greeting-tip-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
}

@keyframes pulse {
  0% {
    transform: translateX(-50%) scale(1);
  }
  50% {
    transform: translateX(-50%) scale(1.05);
  }
  100% {
    transform: translateX(-50%) scale(1);
  }
}

/* 退出确认弹窗 */
.exit-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 300;
}

.exit-modal-content {
  background: linear-gradient(180deg, #2d2d5a 0%, #1a1a3e 100%);
  border-radius: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  margin: 40rpx;
  text-align: center;
  max-width: 600rpx;
  width: 85%;
  position: relative;
}

.exit-modal-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.exit-modal-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.exit-modal-stats {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.exit-modal-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exit-btn {
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exit-btn.continue {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
}

.exit-btn.continue:active {
  opacity: 0.9;
}

.exit-btn .btn-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.exit-btn.quit {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.8);
}

.exit-btn.quit:active {
  background: rgba(255, 255, 255, 0.15);
}

/* 直接退出按钮旁边的小字 */
.exit-modal-content::after {
  content: '直接退出';
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}
