<view class="flashcard {{flipped ? 'flipped' : ''}}" bindtap="flip">
  <view class="card-inner">
    <!-- 正面 - 单词 -->
    <view class="card-front">
      <text class="word">{{word}}</text>
      <text class="phonetic" wx:if="{{phonetic}}">{{phonetic}}</text>
      <text class="hint">点击查看释义</text>
    </view>
    <!-- 背面 - 释义 -->
    <view class="card-back">
      <text class="word">{{word}}</text>
      <text class="definition">{{definition}}</text>
      <view class="actions">
        <view class="action-btn" catchtap="playAudio">🔊</view>
        <view class="action-btn learned" catchtap="markLearned">✓ 已掌握</view>
      </view>
    </view>
  </view>
</view>
