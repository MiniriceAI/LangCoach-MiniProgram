.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 640rpx;
  background: linear-gradient(145deg, #2d2d5a 0%, #3d3d7a 100%);
  border-radius: 24rpx;
  overflow: hidden;
  max-height: 90vh;
  overflow-y: auto;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.close-btn {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1;
}

/* 分数展示 */
.score-section {
  padding: 30rpx;
}

.overall-score {
  text-align: center;
  margin-bottom: 30rpx;
}

.score-number {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  color: #6366f1;
  line-height: 1.2;
}

.score-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.score-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.score-item {
  display: flex;
  align-items: center;
}

.item-label {
  width: 100rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.score-bar {
  flex: 1;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.score-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.item-value {
  width: 60rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* 改进建议 */
.tips-section {
  margin-top: 30rpx;
  padding: 20rpx;
  background: rgba(245, 158, 11, 0.15);
  border-radius: 12rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #f59e0b;
  margin-bottom: 12rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-item {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

/* 评分区域 */
.rating-section {
  padding: 30rpx;
  text-align: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}

.rating-title {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20rpx;
}

.star-rating {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.star {
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.3);
  transition: color 0.2s, transform 0.2s;
}

.star.active {
  color: #FAAD14;
}

.star:active {
  transform: scale(1.2);
}

/* 反馈输入 */
.feedback-section {
  padding: 0 30rpx 30rpx;
}

.feedback-input {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

/* 操作按钮 */
.modal-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 30rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #FFFFFF;
}

.action-btn.secondary {
  background: #F5F7FA;
  color: #666666;
}

.action-btn:active {
  opacity: 0.9;
}
