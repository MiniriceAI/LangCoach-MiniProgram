.bubble-content {
  display: inline-block;
  line-height: 1.6;
  width: 100%;
}

/* 语音消息样式 */
.voice-message {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  min-width: 200rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.bubble-content.user .voice-message {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.voice-icon {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.audio-icon {
  font-size: 32rpx;
  color: #a5b4fc;
}

.bubble-content.user .audio-icon {
  color: #FFFFFF;
}

.audio-icon.playing {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.loading {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.error {
  font-size: 24rpx;
  color: #f87171;
}

.duration {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: auto;
}

.bubble-content.user .duration {
  color: rgba(255, 255, 255, 0.8);
}

/* 语音波形指示器 (用户消息) */
.voice-indicator {
  margin-left: auto;
}

.voice-bars {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.bar {
  width: 6rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 3rpx;
  display: inline-block;
}

.voice-bars.playing .bar {
  animation: wave 1.5s infinite;
}

.voice-bars.playing .bar:nth-child(1) {
  animation-delay: 0s;
}

.voice-bars.playing .bar:nth-child(2) {
  animation-delay: 0.3s;
}

.voice-bars.playing .bar:nth-child(3) {
  animation-delay: 0.6s;
}

@keyframes wave {
  0%, 100% { height: 20rpx; }
  50% { height: 40rpx; }
}

/* 转写提示 */
.transcribing-hint {
  padding: 8rpx 0;
  opacity: 0.7;
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

/* 文本内容样式 */
.text-content {
  display: inline;
}

.word {
  display: inline;
  color: #FFFFFF;
}

.word.clickable:active {
  background: rgba(139, 92, 246, 0.3);
  border-radius: 4rpx;
}

.bubble-content.user .word {
  color: #FFFFFF;
}

.bubble-content.user .voice-message {
  background: rgba(255, 255, 255, 0.2);
}

.bubble-content.assistant .word {
  color: #FFFFFF;
}

/* 听力模式提示 */
.listening-mode-hint {
  padding: 8rpx 0;
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 流式输出光标 */
.streaming-cursor {
  display: inline-block;
  margin-left: 4rpx;
  color: #8b5cf6;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}
