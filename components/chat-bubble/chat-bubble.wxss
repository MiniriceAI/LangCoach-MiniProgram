.bubble-content {
  display: inline-block;
  line-height: 1.6;
  width: 100%;
}

/* 语音消息样式 */
.voice-message {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  min-width: 200rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(5px);
  transition: all 0.3s ease;
}

.voice-message:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.15);
}

.bubble-content.user .voice-message {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.voice-icon {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.audio-icon {
  font-size: 32rpx;
  color: #a5b4fc;
  transition: all 0.3s ease;
}

.bubble-content.user .audio-icon {
  color: #FFFFFF;
}

.audio-icon.playing {
  animation: pulse-scale 1.5s infinite;
  color: #6366f1;
}

.bubble-content.user .audio-icon.playing {
  color: #FFFFFF;
}

@keyframes pulse-scale {
  0%, 100% { 
    transform: scale(1);
    opacity: 1;
  }
  50% { 
    transform: scale(1.1);
    opacity: 0.8;
  }
}

.loading {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.error {
  font-size: 24rpx;
  color: #f87171;
}

.duration {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: auto;
}

.bubble-content.user .duration {
  color: rgba(255, 255, 255, 0.8);
}

/* 语音波形指示器 (用户消息) */
.voice-indicator {
  margin-left: auto;
}

.voice-bars {
  display: flex;
  align-items: center;
  gap: 3rpx;
}

.bar {
  width: 4rpx;
  height: 16rpx;
  background: linear-gradient(to top, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.9));
  border-radius: 2rpx;
  display: inline-block;
  transition: all 0.3s ease;
}

.voice-bars.playing .bar {
  animation: voice-wave 1.4s infinite ease-in-out;
}

.voice-bars.playing .bar:nth-child(1) {
  animation-delay: 0s;
  height: 12rpx;
}

.voice-bars.playing .bar:nth-child(2) {
  animation-delay: 0.2s;
  height: 20rpx;
}

.voice-bars.playing .bar:nth-child(3) {
  animation-delay: 0.4s;
  height: 28rpx;
}

.voice-bars.playing .bar:nth-child(4) {
  animation-delay: 0.6s;
  height: 24rpx;
}

.voice-bars.playing .bar:nth-child(5) {
  animation-delay: 0.8s;
  height: 16rpx;
}

@keyframes voice-wave {
  0%, 100% { 
    transform: scaleY(0.4);
    opacity: 0.7;
  }
  50% { 
    transform: scaleY(1);
    opacity: 1;
  }
}

/* 转写提示 */
.transcribing-hint {
  padding: 8rpx 0;
  opacity: 0.7;
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

/* 文本内容样式 */
.text-content {
  display: inline;
}

.word {
  display: inline;
  color: #FFFFFF;
}

.word.clickable:active {
  background: rgba(139, 92, 246, 0.3);
  border-radius: 4rpx;
}

.bubble-content.user .word {
  color: #FFFFFF;
}

.bubble-content.user .voice-message {
  background: rgba(255, 255, 255, 0.2);
}

.bubble-content.assistant .word {
  color: #FFFFFF;
}

/* 听力模式提示 */
.listening-mode-hint {
  padding: 8rpx 0;
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}
